/**
 * Terminal-style code block. Geist says no shadows and hairline borders; code
 * gets a slightly lighter surface so it separates without decoration.
 */
interface Props {
  code: string
  lang?: 'bash' | 'json' | 'text'
  title?: string
}
const { code, lang = 'bash', title } = Astro.props
---

<figure class="border border-line bg-surface-1">
  {
    title && (
      <figcaption class="rule flex items-center justify-between px-4 py-2 font-mono text-xs text-fg-subtle">
        <span>{title}</span>
        <span>{lang}</span>
      </figcaption>
    )
  }
  <pre class="overflow-x-auto px-4 py-4 text-sm leading-relaxed"><code class="text-fg">{code.trim()}</code></pre>
</figure>