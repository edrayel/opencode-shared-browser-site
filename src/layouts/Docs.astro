import Base from './Base.astro'

interface Props {
  title: string
  description: string
}
const { title, description } = Astro.props

const NAV = [
  { href: '/docs/install/', label: 'Install' },
  { href: '/docs/guards/', label: 'Guards' },
  { href: '/docs/limitations/', label: 'Limitations' },
]
const current = Astro.url.pathname
---

<Base title={`${title} — opencode-shared-browser`} description={description}>
  <div class="shell grid gap-12 py-14 lg:grid-cols-[13rem_1fr]">
    <nav aria-label="Documentation" class="lg:sticky lg:top-8 lg:self-start">
      <p class="font-mono text-xs tracking-wide text-fg-subtle uppercase">Docs</p>
      <ul class="mt-4 flex gap-5 lg:flex-col lg:gap-2">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={current === item.href ? 'page' : undefined}
                class:list={[
                  'text-sm transition-colors',
                  current === item.href ? 'text-fg' : 'text-fg-muted hover:text-fg',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <article class="min-w-0 max-w-2xl">
      <h1>{title}</h1>
      <div class="prose mt-8">
        <slot />
      </div>
    </article>
  </div>
</Base>

<style is:global>
  /* Article styling kept global so it can reach slot content from other
     components without threading a class through every call site. Scoped to
     .prose so it cannot leak into the landing page. */
  .prose > * + * {
    margin-top: 1.1rem;
  }
  .prose h2 {
    font-size: 1.5rem;
    margin-top: 2.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-line);
  }
  .prose h3 {
    font-size: 1.0625rem;
    margin-top: 2rem;
  }
  .prose p,
  .prose li {
    color: var(--color-fg-muted);
    line-height: 1.75;
  }
  .prose ul {
    list-style: none;
    padding-left: 0;
  }
  .prose ul > li {
    position: relative;
    padding-left: 1.25rem;
  }
  .prose ul > li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.375rem;
    height: 0.375rem;
    background: var(--color-fg-subtle);
  }
  .prose strong {
    color: var(--color-fg);
    font-weight: 500;
  }
  /* Inline code must be allowed to wrap. Long values (a flag list, a filename)
     otherwise push the measure wider than the viewport on small screens. */
  .prose :not(pre) > code {
    font-size: 0.8125rem;
    background: var(--color-surface-2);
    padding: 0.1rem 0.35rem;
    overflow-wrap: anywhere;
  }
  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .prose th,
  .prose td {
    text-align: left;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--color-line);
    vertical-align: top;
  }
  .prose th {
    color: var(--color-fg);
    font-weight: 500;
  }
  .prose td {
    color: var(--color-fg-muted);
  }
</style>